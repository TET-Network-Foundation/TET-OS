# Tet-Core REST base URL. The public seeds expose only 8002/tcp (p2p) — their REST port 5010 is
# deliberately not reachable from outside, so point this at a node YOU run:
#   docker compose up -d   →   http://127.0.0.1:5010
# (Earlier versions of this file defaulted to a seed's 5010, which has never been open.)
TET_CORE_URL=http://127.0.0.1:5010
TET_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
