{
  "name": "tet-agent-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "preignite": "npm run build",
    "ignite": "ts-node --esm --project examples/tsconfig.json examples/ignition.ts",
    "ignite:tsx": "npm run build && tsx examples/ignition.ts",
    "attack": "ts-node --esm --project examples/tsconfig.json examples/attacker.ts",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand"
  },
  "dependencies": {
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/jest": "^29.5.14",
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.3.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.19.0"
  }
}
