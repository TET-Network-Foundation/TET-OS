# Git / editor
.git
.github
.cursor
.DS_Store

# Rust artifacts (keep sources under methods/, nexus-protocol/, tet-core/)
**/target/
**/*.rs.bk

# Node / frontend build outputs
**/node_modules/
**/.next/
**/out/
**/dist/

# Local ledger DBs and test data
tet-core/tet.db*
tet.db*
**/*.db
test-ledger/

# Archived / unused for canonical tet-core image
tet-core-node/
tet-network/chain/
nexus network/
nexus-onchain/
observability/
deploy/
web-wallet/
nexus-frontend/
pwa/

# NOTE: tet-network/ui/ is deliberately NOT excluded. Both images build from the
# repository root: the UI image needs app sources AND the Rust workspace (its
# first stage builds tet-pqc-wasm). node_modules/ and .next/ are already
# excluded by the wildcards above, so the UI costs little context.

# Logs and bulky runtime files
*.log
bootnode.log
client.log
