# The demo node's only internet-facing listener (docs/DEMO_NODE.md).
#
# Two rules this file keeps, each asserted by deploy/tests/demo-node.test.sh:
#
# 1. No `trusted_proxies`: without it Caddy (2.5+) replaces any client-supplied X-Forwarded-For with
#    the real remote address, and tet-core's per-client limits rely on that.
# 2. Caddy enforces tet-core's allow-list itself, independently of tet-core: `@tet_allowed` below is
#    PUBLIC_ALLOWLIST (tet-core/src/rest/public_api.rs) as method + path. A tet-core that is not in
#    public mode (an old image, a missing env var) still cannot be reached on any other route, and
#    the UI's own server routes (/api/*) are not reachable at all. Only the /try page, its static
#    files and the allow-listed node API are served.
{
	email {$TET_DEMO_ACME_EMAIL}
}

{$TET_DEMO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@tet_allowed expression `
			({method} == "GET" && {path}.matches("^/tet-node-api/status$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/chain$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/ledger/state$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/ledger/balance/[^/%]+$")) ||
			({method} == "POST" && {path}.matches("^/tet-node-api/tmail/send$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/tmail/inbox/[^/%]+$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/tmail/keys/[^/%]+$")) ||
			({method} == "PUT" && {path}.matches("^/tet-node-api/tmail/keys/[^/%]+$")) ||
			({method} == "POST" && {path}.matches("^/tet-node-api/tmail/keys/[^/%]+$")) ||
			({method} == "POST" && {path}.matches("^/tet-node-api/tmail/read-receipt$")) ||
			({method} == "POST" && {path}.matches("^/tet-node-api/tmail/anon/register$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/tmail/anon/root$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/tmail/anon/leaves$")) ||
			({method} == "PUT" && {path}.matches("^/tet-node-api/tmail/anon/receipt$")) ||
			({method} == "POST" && {path}.matches("^/tet-node-api/tmail/anon/receipt$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/tmail/anon/receipt/[^/%]+$")) ||
			({method} == "POST" && {path}.matches("^/tet-node-api/files/upload$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/files/inbox/[^/%]+$")) ||
			({method} == "GET" && {path}.matches("^/tet-node-api/files/fetch/[^/%]+$")) ||
			({method} == "DELETE" && {path}.matches("^/tet-node-api/files/item/[^/%]+$"))`

	handle /tet-node-api/* {
		handle @tet_allowed {
			reverse_proxy ui:3000
		}
		respond 404
	}

	# The UI's own server routes proxy to other services; none of them is part of the demo.
	handle /api/* {
		respond 404
	}

	@page path /try /try/* /_next/* /pqc/* /favicon.ico
	handle @page {
		reverse_proxy ui:3000
	}

	handle / {
		redir /try 302
	}

	handle {
		respond 404
	}
}
