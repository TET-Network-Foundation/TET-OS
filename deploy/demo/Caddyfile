# The demo node's only internet-facing listener (docs/DEMO_NODE.md).
#
# Rules this file keeps, each asserted by deploy/tests/demo-node.test.sh:
#
# 1. No `trusted_proxies`: without it Caddy (2.5+) replaces any client-supplied X-Forwarded-For with
#    the real remote address, and tet-core's per-client limits rely on that.
# 2. Ambiguous paths are refused before anything else (400): an encoded `.`, `/` or `\`, a double
#    encoding (`%25`), a dot-segment or an empty segment. Caddy matches the decoded path but forwards
#    the raw one, and Next.js normalises it again: without this, `/try/..%2Fapi%2F…` passed the `/try`
#    rule and reached the UI's internal /api routes (commit security review of #37).
# 3. Caddy enforces tet-core's allow-list itself: `@tet_allowed` is PUBLIC_ALLOWLIST
#    (tet-core/src/rest/public_api.rs) as method + path, a second layer that holds even if tet-core is
#    not in public mode.
# 4. Only the /try page, its static files and the allow-listed node API are served; everything
#    else, the UI's own /api/* routes included, is 404. One `route` block, so the order below is the
#    order of evaluation.
# 5. No client address in any log. There is no access log (no `log` in the site block), and the
#    default logger, which carries Caddy's error entries with the whole request, drops every field
#    that holds an address. The page says "the demo node sees your IP address and doesn't log it";
#    this is what makes that true for Caddy. TLS handshake errors name the client in their message
#    text, which no field filter reaches; Caddy logs them only at DEBUG, so never run the demo at
#    DEBUG. Checked by demo-node.test.sh, with a control that runs the Caddyfile without this block.
{
	email {$TET_DEMO_ACME_EMAIL}
	log default {
		output stderr
		format filter {
			wrap json
			fields {
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers>X-Forwarded-For delete
				request>headers>X-Real-Ip delete
				request>headers>Forwarded delete
			}
		}
	}
}

{$TET_DEMO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	@ambiguous_path expression `{http.request.uri}.matches("^[^?]*(?:(?i:%2e|%2f|%5c|%25)|\\\\|//|/\\.{1,2}(?:/|\\?|$))")`

	@tet_allowed expression `
		({method} == "GET" && {path}.matches("^/tet-node-api/status$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/chain$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/ledger/state$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/ledger/balance/[^/%]+$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/explorer/tx/[^/%]+$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/explorer/blocks/recent$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/status/live$")) ||
		({method} == "POST" && {path}.matches("^/tet-node-api/tmail/send$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/tmail/inbox/[^/%]+$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/tmail/keys/[^/%]+$")) ||
		({method} == "PUT" && {path}.matches("^/tet-node-api/tmail/keys/[^/%]+$")) ||
		({method} == "POST" && {path}.matches("^/tet-node-api/tmail/keys/[^/%]+$")) ||
		({method} == "POST" && {path}.matches("^/tet-node-api/tmail/read-receipt$")) ||
		({method} == "POST" && {path}.matches("^/tet-node-api/tmail/anon/register$")) ||
		({method} == "POST" && {path}.matches("^/tet-node-api/tmail/poll/root$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/tmail/poll/root/[^/%]+$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/tmail/anon/commitment/[^/%]+$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/tmail/anon/root$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/tmail/anon/leaves$")) ||
		({method} == "PUT" && {path}.matches("^/tet-node-api/tmail/anon/receipt$")) ||
		({method} == "POST" && {path}.matches("^/tet-node-api/tmail/anon/receipt$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/tmail/anon/receipt/[^/%]+$")) ||
		({method} == "POST" && {path}.matches("^/tet-node-api/files/upload$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/files/upload-budget$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/files/inbox/[^/%]+$")) ||
		({method} == "GET" && {path}.matches("^/tet-node-api/files/fetch/[^/%]+$")) ||
		({method} == "DELETE" && {path}.matches("^/tet-node-api/files/item/[^/%]+$")) ||
		({method} == "POST" && {path}.matches("^/tet-node-api/demo/files/sponsor-fee$"))`

	@page path /try /_next/static/* /pqc/* /brand/* /favicon.ico /apple-icon.png

	route {
		respond @ambiguous_path 400
		redir / /try 302
		reverse_proxy @tet_allowed ui:3000
		reverse_proxy @page ui:3000
		respond 404
	}
}
