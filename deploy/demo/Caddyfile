# The demo node's only internet-facing listener (docs/DEMO_NODE.md).
#
# Do NOT add `trusted_proxies`: without it Caddy (2.5+) replaces any client-supplied
# X-Forwarded-For with the real remote address, and tet-core's per-client limits rely on that.
# deploy/tests/demo-node.test.sh fails if this file gains one.
{
	email {$TET_DEMO_ACME_EMAIL}
}

{$TET_DEMO_DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	reverse_proxy ui:3000
}
