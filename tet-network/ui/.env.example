# TET Sovereign OS — copy to .env.local and adjust for your node.

# REST target (browser). Omit to use same-origin proxy /tet-node-api → 127.0.0.1:5010
# NEXT_PUBLIC_TET_CORE_URL=http://127.0.0.1:5010

# Must match the node's TET_TREASURY_ADDRESS (64 hex). Required for hybrid signatures unless genesis hash is overridden.
NEXT_PUBLIC_TET_TREASURY_ADDRESS=fedcba0987654321fedcba0987654321fedcba0987654321fedcba0987654321

# Optional: match node TET_CHAIN_ID / mainnet flag (default tet-local-dev)
# NEXT_PUBLIC_TET_CHAIN_ID=tet-local-dev
# NEXT_PUBLIC_TET_MAINNET=0

# Optional: match TET_GENESIS_FOUNDER_WALLET_ID or TET_FOUNDER_WALLET on the node
# NEXT_PUBLIC_TET_GENESIS_FOUNDER_WALLET_ID=57e0b29d233917a619d0f335dfc1135add3359c49590720cfb0f9f70d71f36a0
# NEXT_PUBLIC_TET_FOUNDER_WALLET=

# Advanced: skip local hash computation (must match node ledger meta exactly)
# NEXT_PUBLIC_TET_GENESIS_HASH=0x...
